(defmethod microstrain_inertial_msgs::HumanReadableStatus
  (:init
   (&key
    ((:header __header) (instance std_msgs::Header :init))
    ((:device_info __device_info) (instance microstrain_inertial_msgs::MipBaseDeviceInfo :init))
    ((:gnss_state __gnss_state) "")
    ((:dual_antenna_fix_type __dual_antenna_fix_type) "")
    ((:filter_state __filter_state) "")
    ((:status_flags __status_flags) (let (r) (dotimes (i 0) (push "" r)) r))
    ((:continuous_bit_flags __continuous_bit_flags) (let (r) (dotimes (i 0) (push "" r)) r))
    )
   (send-super :init)
   (setq _header __header)
   (setq _device_info __device_info)
   (setq _gnss_state (string __gnss_state))
   (setq _dual_antenna_fix_type (string __dual_antenna_fix_type))
   (setq _filter_state (string __filter_state))
   (setq _status_flags __status_flags)
   (setq _continuous_bit_flags __continuous_bit_flags)
   self)
  (:header
   (&rest __header)
   (if (keywordp (car __header))
       (send* _header __header)
     (progn
       (if __header (setq _header (car __header)))
       _header)))
  (:device_info
   (&rest __device_info)
   (if (keywordp (car __device_info))
       (send* _device_info __device_info)
     (progn
       (if __device_info (setq _device_info (car __device_info)))
       _device_info)))
  (:gnss_state
   (&optional __gnss_state)
   (if __gnss_state (setq _gnss_state __gnss_state)) _gnss_state)
  (:dual_antenna_fix_type
   (&optional __dual_antenna_fix_type)
   (if __dual_antenna_fix_type (setq _dual_antenna_fix_type __dual_antenna_fix_type)) _dual_antenna_fix_type)
  (:filter_state
   (&optional __filter_state)
   (if __filter_state (setq _filter_state __filter_state)) _filter_state)
  (:status_flags
   (&optional __status_flags)
   (if __status_flags (setq _status_flags __status_flags)) _status_flags)
  (:continuous_bit_flags
   (&optional __continuous_bit_flags)
   (if __continuous_bit_flags (setq _continuous_bit_flags __continuous_bit_flags)) _continuous_bit_flags)
  (:serialization-length
   ()
   (+
    ;; std_msgs/Header _header
    (send _header :serialization-length)
    ;; microstrain_inertial_msgs/MipBaseDeviceInfo _device_info
    (send _device_info :serialization-length)
    ;; string _gnss_state
    4 (length _gnss_state)
    ;; string _dual_antenna_fix_type
    4 (length _dual_antenna_fix_type)
    ;; string _filter_state
    4 (length _filter_state)
    ;; string[] _status_flags
    (apply #'+ (mapcar #'(lambda (x) (+ 4 (length x))) _status_flags)) 4
    ;; string[] _continuous_bit_flags
    (apply #'+ (mapcar #'(lambda (x) (+ 4 (length x))) _continuous_bit_flags)) 4
    ))
  (:serialize
   (&optional strm)
   (let ((s (if strm strm
              (make-string-output-stream (send self :serialization-length)))))
     ;; std_msgs/Header _header
       (send _header :serialize s)
     ;; microstrain_inertial_msgs/MipBaseDeviceInfo _device_info
       (send _device_info :serialize s)
     ;; string _gnss_state
       (write-long (length _gnss_state) s) (princ _gnss_state s)
     ;; string _dual_antenna_fix_type
       (write-long (length _dual_antenna_fix_type) s) (princ _dual_antenna_fix_type s)
     ;; string _filter_state
       (write-long (length _filter_state) s) (princ _filter_state s)
     ;; string[] _status_flags
     (write-long (length _status_flags) s)
     (dolist (elem _status_flags)
       (write-long (length elem) s) (princ elem s)
       )
     ;; string[] _continuous_bit_flags
     (write-long (length _continuous_bit_flags) s)
     (dolist (elem _continuous_bit_flags)
       (write-long (length elem) s) (princ elem s)
       )
