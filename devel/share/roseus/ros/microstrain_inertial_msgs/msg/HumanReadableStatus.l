     (send _device_info :deserialize buf ptr-) (incf ptr- (send _device_info :serialization-length))
   ;; string _gnss_state
     (let (n) (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4) (setq _gnss_state (subseq buf ptr- (+ ptr- n))) (incf ptr- n))
   ;; string _dual_antenna_fix_type
     (let (n) (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4) (setq _dual_antenna_fix_type (subseq buf ptr- (+ ptr- n))) (incf ptr- n))
   ;; string _filter_state
     (let (n) (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4) (setq _filter_state (subseq buf ptr- (+ ptr- n))) (incf ptr- n))
