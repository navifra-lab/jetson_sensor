     (setq _status_flags (make-list n))
     (dotimes (i n)
     (let (n) (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4) (setf (elt _status_flags i) (subseq buf ptr- (+ ptr- n))) (incf ptr- n))
     ))
   ;; string[] _continuous_bit_flags
   (let (n)
     (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4)
     (setq _continuous_bit_flags (make-list n))
     (dotimes (i n)
     (let (n) (setq n (sys::peek buf ptr- :integer)) (incf ptr- 4) (setf (elt _continuous_bit_flags i) (subseq buf ptr- (+ ptr- n))) (incf ptr- n))
